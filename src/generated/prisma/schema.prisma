generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum VisibilityEnum {
  public
  private
  friends
}

enum CensorEnum {
  approved
  pending
  rejected
  under_review
}

enum MediaTypeEnum {
  image
  video
  file
}

enum NotificationTypeEnum {
  like
  comment
  share
}

enum PostTypeEnum {
  post
  reel
  story
}

// Models
model Users {
  id        String  @id @default(uuid())
  username  String  @unique
  fullname  String?
  avatarUrl String? @default("https://i.pinimg.com/736x/c6/e5/65/c6e56503cfdd87da299f72dc416023d4.jpg")

  posts         Posts[] // Quan hệ 1-n với Posts
  likes         Likes[] // Quan hệ 1-n với Likes
  comments      Comments[] // Quan hệ 1-n với Comments
  shares        Shares[] // Quan hệ 1-n với Shares
  newsFeed      NewsFeed[] // Quan hệ 1-n với NewsFeed
  taggedInPosts PostTagFriend[] @relation("TaggedUser")
  taggedByPosts PostTagFriend[] @relation("TaggedBy")
  viewedPosts   Viewer[]        @relation("UserViewers")
}

model Posts {
  id            String          @id @default(uuid())
  userId        String
  title         String?
  content       String?
  postType      PostTypeEnum    @default(post)
  visibility    VisibilityEnum  @default(public)
  censor        CensorEnum      @default(pending)
  shareCount    Int             @default(0)
  likeCount     Int             @default(0)
  commentCount  Int             @default(0)
  createdAt     DateTime        @default(now())
  expired_at    DateTime?
  updatedAt     DateTime        @default(now())
  user          Users           @relation(fields: [userId], references: [id])
  hashtags      PostHashtags[] // Quan hệ n-n với Hashtag
  taggedFriends PostTagFriend[] // Quan hệ n-n với Users qua PostTagFriend
  media         Media[] // Quan hệ 1-n với Media
  likes         Likes[] // Quan hệ 1-n với Likes
  comments      Comments[] // Quan hệ 1-n với Comments
  shares        Shares[] // Quan hệ 1-n với Shares
  newsFeed      NewsFeed[] // Quan hệ 1-n với NewsFeed
  viewers       Viewer[]        @relation("PostViewers")
}

model Viewer {
  id       Int      @id @default(autoincrement())
  userId   String
  postId   String
  viewedAt DateTime @default(now())

  user Users @relation("UserViewers", fields: [userId], references: [id])
  post Posts @relation("PostViewers", fields: [postId], references: [id])

  @@unique([userId, postId])
}

model Hashtag {
  id        String         @id @default(uuid())
  name      String         @unique @db.VarChar(100)
  createdAt DateTime       @default(now())
  posts     PostHashtags[] // Quan hệ n-n với Posts
}

model PostHashtags {
  postId    String
  hashtagId String

  post    Posts   @relation(fields: [postId], references: [id])
  hashtag Hashtag @relation(fields: [hashtagId], references: [id])

  @@id([postId, hashtagId])
}

model PostTagFriend {
  id           String   @id @default(uuid())
  postId       String
  userId       String
  taggedBy     String
  createdAt    DateTime @default(now())
  post         Posts    @relation(fields: [postId], references: [id])
  user         Users    @relation("TaggedUser", fields: [userId], references: [id])
  taggedByUser Users    @relation("TaggedBy", fields: [taggedBy], references: [id])
}

model Media {
  id        String        @id @default(uuid())
  postId    String
  mediaUrl  String
  mediaType MediaTypeEnum
  createdAt DateTime      @default(now())
  post      Posts         @relation(fields: [postId], references: [id])
}

model Likes {
  id        String   @id @default(uuid())
  userId    String?
  postId    String
  createdAt DateTime @default(now())

  user Users? @relation(fields: [userId], references: [id])
  post Posts  @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model Comments {
  id        String   @id @default(uuid())
  userId    String?
  postId    String
  parentId  String?
  content   String
  createdAt DateTime @default(now())

  user    Users?     @relation(fields: [userId], references: [id])
  post    Posts      @relation(fields: [postId], references: [id])
  parent  Comments?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comments[] @relation("CommentReplies")
}

model Shares {
  id        String   @id @default(uuid())
  userId    String?
  postId    String
  createdAt DateTime @default(now())
  user      Users?   @relation(fields: [userId], references: [id])
  post      Posts    @relation(fields: [postId], references: [id])
}

model NewsFeed {
  id        String   @id @default(uuid())
  userId    String?
  postId    String
  reason    String?  @db.VarChar(50)
  score     Float
  isNew     Boolean?
  createdAt DateTime @default(now())

  user Users? @relation(fields: [userId], references: [id])
  post Posts  @relation(fields: [postId], references: [id])
}
